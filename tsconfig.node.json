{
  "compilerOptions": {
    "composite": true,               // ✅ REQUIRED
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noEmitOnError": false
  },
  "include": ["vite.config.ts"]
}
